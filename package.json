{
  "name": "silky-recorder",
  "version": "0.1.0",
  "description": "Record silky-smooth product tutorial videos from a declarative scenario: clean isolated browser (no extension artifacts), animated cursor, zoom camera, captions, click/keyboard sounds and background music.",
  "keywords": [
    "demo-video",
    "product-demo",
    "screencast",
    "screen-recording",
    "tutorial",
    "playwright",
    "headless",
    "ffmpeg",
    "text-to-speech",
    "voiceover",
    "documentation",
    "devrel"
  ],
  "homepage": "https://github.com/harlamenko/silky-recorder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlamenko/silky-recorder.git"
  },
  "bugs": {
    "url": "https://github.com/harlamenko/silky-recorder/issues"
  },
  "type": "module",
  "bin": {
    "silky": "bin/silky.mjs"
  },
  "scripts": {
    "login": "node bin/silky.mjs login",
    "record": "node bin/silky.mjs record",
    "voices": "node bin/silky.mjs voices",
    "test": "node --test test/*.test.mjs",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "node-edge-tts": "^1.2.10",
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
